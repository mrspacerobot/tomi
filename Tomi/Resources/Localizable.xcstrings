      "comment": "Line under the title of the avoid question.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allergies and things you never eat. Tick all that apply."
          }
        }
      }
    },
