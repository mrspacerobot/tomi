        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomi keeps your photo exactly as your phone made it, with where and when it was taken, and the ingredients you confirm. The AI model reads this same file. You can withdraw this at any time and the photos are deleted."
          }
        }
      }
    },
