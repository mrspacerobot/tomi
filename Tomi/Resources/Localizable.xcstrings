    "onboarding.diet.everything.name": {
      "comment": "Answer to the diet question: the cook eats all food.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything"
          }
        }
      }
