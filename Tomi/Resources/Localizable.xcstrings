      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meat, fish, the lot"
          }
        }
      }
    },
    "onboarding.diet.hint": {
      "comment": "Line under the answers of the diet question.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap one and we move on. You can change it later in Settings."
          }
        }
      }
    },
    "onboarding.diet.subtitle": {
      "comment": "Line under the title of the diet question.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dishes that do not fit never reach your menu."
          }
        }
      }
    },
    "onboarding.diet.title": {
      "comment": "Title of the diet question in onboarding.",
      "extractionState": "manual",
      "localizations": {
