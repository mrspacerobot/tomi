      "comment": "Line under the title of the avoid question.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allergies and things you never eat. Tick all that apply."
          }
        }
      }
    },
    "onboarding.avoid.summary": {
      "comment": "Line above Continue on the avoid question. The placeholder is the names of the ticked items as a list, such as \"Nuts and Shellfish\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoiding %@."
          }
        }
      }
    },
    "onboarding.avoid.title": {
      "comment": "Title of the question about allergies and foods the cook never eats.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything to avoid?"
          }
        }
      }
    },
    "onboarding.back": {
      "comment": "VoiceOver name of the Back button at the top left of every onboarding question.",
      "extractionState": "manual",
      "localizations": {
