      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomi does not know \"%@\" yet"
          }
        }
      }
    },
    "confirm.find": {
      "comment": "Button that asks for tonight's special with the confirmed ingredients.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find tonight's special"
          }
        }
      }
    },
    "nothingTonight.title": {
      "comment": "Title shown when the server has no dish for the cook tonight. Not an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to cook from this yet"
          }
        }
      }
    },
    "nothingTonight.message": {
      "comment": "Message shown when there is no special tonight.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomi has no dish for this fridge at your level yet. Add a few more things, or come back as you learn more."
          }
        }
      }
    },
    "nothingTonight.change": {
      "comment": "Button that goes back to the ingredient list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change what I have"
          }
        }
      }
    },
    "nothingTonight.home": {
      "comment": "Button that returns home.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back home"
          }
        }
      }
    },
    "specials.kicker": {
      "comment": "Label set into the top edge of the box holding tonight's special. Shown in capitals by the design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight's special"
          }
        }
      }
    },
    "specials.alternatives": {
      "comment": "Heading above the alternatives to tonight's special. Shown in capitals by the design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or instead"
          }
        }
      }
    },
    "offer.line": {
      "comment": "Line under a dish's name. First the minutes it takes, then the technique's name, then the level's name, both from the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld min · %2$@, %3$@"
          }
        }
      }
    },
    "offer.cook": {
      "comment": "Button that opens the lesson of a dish on offer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook this"
          }
        }
      }
    },
    "offer.swap": {
      "comment": "A swap Tomi made to the dish. First the ingredient put in, then the one taken out, both named by the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ instead of %2$@"
          }
        }
      }
    },
    "offer.missing": {
      "comment": "What the cook still needs for the dish. The placeholder is a list of ingredient names joined by the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To buy: %@"
          }
        }
      }
    },
    "player.missing.title": {
      "comment": "Title shown when the offered lesson is not in the phone's library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dish is not on your phone yet"
          }
        }
      }
    },
    "player.missing.message": {
      "comment": "Message shown when the offered lesson is not in the phone's library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Tomi to cook it. Your other dishes are still here."
          }
        }
      }
    },
    "player.step": {
      "comment": "Label above a lesson step. The number counts the steps from 1. Shown in capitals by the design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld"
          }
        }
      }
    },
    "player.next": {
      "comment": "Button that moves the lesson player to the next page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "player.finish": {
      "comment": "Button that ends the lesson after the question and logs the cook.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        }
      }
    },
    "player.stop": {
      "comment": "Button that ends the lesson early. Such a cook earns nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I stopped"
          }
        }
      }
    },
