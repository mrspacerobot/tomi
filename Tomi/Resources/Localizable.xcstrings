    "onboarding.avoid.none": {
      "comment": "Answer to the avoid question: the cook avoids nothing. Ticking it clears the other ticks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of these"
          }
        }
      }
    },
    "onboarding.avoid.note": {
      "comment": "Note under the avoid list. \"I\" is Tomi.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I leave these out of every dish and check again after any swap. I cannot read packaging, so please still check the labels."
          }
        }
      }
    },
