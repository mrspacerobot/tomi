  "strings": {
    "chip.locked.value": {
      "comment": "VoiceOver state of a cupboard chip the cook cannot switch off, read after the ingredient name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always there"
          }
        }
      }
    },
