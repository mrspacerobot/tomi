    "onboarding.welcome.body": {
      "comment": "Line under the title on the welcome screen. \"I\" is Tomi.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show me what you have. I write a menu that teaches you one technique at a time."
          }
        }
      }
