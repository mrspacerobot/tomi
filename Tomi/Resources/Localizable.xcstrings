      "comment": "Heading of the settings section about the photo consents.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fridge photos"
          }
        }
      }
    },
    "settings.withdrawDataset": {
      "comment": "Button that withdraws the photo-dataset consent; the server deletes every kept photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop keeping my photos and delete them"
          }
        }
      }
    },
    "settings.withdrawScan": {
      "comment": "Button that withdraws the photo-scan consent; Tomi will ask again before the next scan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sending photos"
          }
        }
      }
    }
